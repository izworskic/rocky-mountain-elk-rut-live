{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/live.js": { "maxDuration": 25 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/national-tools/elk-rut/index.html" },
    { "source": "/national-tools/elk-rut", "destination": "/national-tools/elk-rut/index.html" },
    { "source": "/national-tools/elk-rut/", "destination": "/national-tools/elk-rut/index.html" }
  ],
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public"
}
